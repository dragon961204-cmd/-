{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOTM organization entry",
  "type": "object",
  "required": [
    "id",
    "name_zh",
    "category",
    "canon_status",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name_zh": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "secret_organization",
        "official",
        "church",
        "family",
        "faction",
        "historical_organization",
        "other"
      ]
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canon_status": {
      "type": "string",
      "enum": [
        "verified",
        "needs_verification",
        "inferred",
        "original_game"
      ]
    },
    "active_in_1349": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "joinable": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "undecided"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
