  "narrative_biography": {
    "schema_version": "1.0",
    "title": "格羅塞爾｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "巨人王庭的守衛",
        "prose": "格羅塞爾曾在巨人王庭服勤，輪值看守衰敗森林與宮殿通道。離開王庭後，他經過晨曦鎮前往黃金之國，後來被困在《格羅塞爾遊記》的世界，成為書中營地的領袖。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-de124147e5c1.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "領隊挑戰北方之王",
        "prose": "克萊恩循艾德雯娜的線索見到格羅塞爾時，他已與來自不同年代的同伴組成隊伍。為了履行承諾，他在決戰中再次近身纏住尤里斯安，替隊友創造機會，自己則戰死在冰霜巨龍倒下之前。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-de124147e5c1.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "骨灰回到王庭",
        "prose": "克萊恩帶走他的骨灰，後來又藉書中形象的夢境認出他曾住過的地方。抵達真正的巨人王庭時，克萊恩把骨灰撒在原本的守衛居所，使這位離鄉數千年的巨人得以歸故里。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-de124147e5c1.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
