  "narrative_biography": {
    "schema_version": "1.0",
    "title": "恩佐｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "離開生命學派",
        "prose": "恩佐在命運途徑晉升到序列5贏家，原屬生命學派，受玫瑰學派引誘後叛離。克萊恩在南大陸遇見他並將他製成祕偶，此後透過他的能力利用累積的幸運。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-1eda6af17544.html",
          "https://lotmfanwiki.com/node/cn-p-15c1e0f29384.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "改名恩尤尼",
        "prose": "克萊恩帶著恩佐探索卡爾德隆，也用他協助對付因斯。之後克萊恩替他改換外貌、取名恩尤尼，讓他以道恩·唐泰斯的貼身男僕身分出入貝克蘭德。阿蒙後來寄生這具祕偶，克萊恩在脫身過程中失去了它。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-1eda6af17544.html",
          "https://lotmfanwiki.com/node/cn-p-15c1e0f29384.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "巨人王庭的歷史投影",
        "prose": "克萊恩在巨人王庭召出的是尚未被寄生的恩尤尼之歷史投影。它打開王庭宮殿後受薩斯利爾沉睡處的力量侵蝕，轉而與白銀城隊伍交戰，最後被洛薇雅等人撕裂，由戴里克以陽炎燒盡。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-1eda6af17544.html",
          "https://lotmfanwiki.com/node/cn-p-15c1e0f29384.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
