  "historical_sections": [
    {
      "part": 1,
      "title": "人物起點",
      "summary": "梅麗莎是莫雷蒂家的妹妹，重視技術與機械，受到家庭財政條件制約但希望透過教育改善生活。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "克萊恩的工作和收入對家庭安排有直接影響，家人的日常對非凡活動的認識遠低於讀者。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "在廷根事件後，她必須面對家庭結構和生活期待的改變。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "她的價值在於呈現普通人的困境與韌性，而不是替主角傳送機密。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "可作城市教育、住房、工業就業和家庭情節角色。",
      "verification": "needs_original_chapter"
    }
  ],
