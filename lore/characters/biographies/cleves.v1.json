  "narrative_biography": {
    "schema_version": "1.0",
    "title": "克里維斯｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "從出海冒險到受僱護衛",
        "prose": "克里維斯自稱曾是冒險家，後來替布蘭奇一家當保鏢。他還惦記著沉沒的月桂號，說如果能找到那條船，就回家與妻兒團聚，結束在海上的冒險。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-1eb10494cf32.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "白瑪瑙號上的護衛",
        "prose": "他隨雇主乘白瑪瑙號出海，曾在甲板引出魚人並近身交戰。海盜逼近時，他與其他護衛守住雇主的房間；察覺同行者像通緝令上的達尼茲後，他也私下找格爾曼問明情況。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-1eb10494cf32.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "班西港異變",
        "prose": "班西港的異常打斷了航程，他在港口與堂娜等人會合。格爾曼帶人前往風暴教堂避險，克里維斯繼續護送布蘭奇一家脫離危險。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-1eb10494cf32.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
