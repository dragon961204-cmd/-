  "historical_sections": [
    {
      "part": 1,
      "title": "人物起點",
      "summary": "阿爾傑服務風暴之主教會，熟悉海上航行、軍事紀律和非凡情報，處事注重交換價值與風險控制。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "成為倒吊人後利用灰霧聚會跨地域交換材料、配方與知識；起初對愚者的力量與身份有自己的誤判。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "他的職務、野心與教會規矩相互牽制，海上調查讓他接觸海盜、殖民地、遺跡與秘密交易。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "隨塔羅會逐漸壯大，他開始承擔更多組織事務，其對權勢的追求和忠誠關係亦經過改變。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "海上 NPC 的出場需檢查航線與船期；不能因為玩家人在廷根就直接找到他。",
      "verification": "needs_original_chapter"
    }
  ],
