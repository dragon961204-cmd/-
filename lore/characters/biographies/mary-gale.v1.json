  "narrative_biography": {
    "schema_version": "1.0",
    "title": "瑪麗夫人｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "查明丈夫的婚外情",
        "prose": "瑪麗的丈夫多拉古是考伊姆公司的經理。她透過薩默爾太太委託夏洛克調查，拿到丈夫與情婦往來的照片後，兩人的婚姻進入協議離婚階段。她也請塔利姆推薦夏洛克加入克拉格俱樂部，替他支付初始會費。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-32c95cc14b77.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "調查工廠污染",
        "prose": "瑪麗參與大氣污染調查時，收到附有殘破玩偶的恐嚇信。她報警後再次找上夏洛克，將自己在調查中受到的壓力告訴他。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-32c95cc14b77.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "考伊姆公司的股權角力",
        "prose": "後來，瑪麗與友人聯手爭取公司控制權，並質押股份借款。公司有股份出售時，她請道恩·唐泰斯出面收購並簽協議，試圖把這部分股份納入自己一方。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-32c95cc14b77.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
