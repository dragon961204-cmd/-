  "narrative_biography": {
    "schema_version": "1.0",
    "title": "于爾根｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "明斯克街的律師",
        "prose": "于爾根與祖母多麗絲太太、貓布羅迪住在貝克蘭德，是化名夏洛克的克萊恩的鄰居。他先替克萊恩辦理保釋，後來又幫忙擬投資合約、在警局陪同辯護，兩人逐漸建立正式合作。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-ee2d1170ed98.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "從委託往來到互相照應",
        "prose": "克萊恩替出門的于爾根照顧布羅迪，也帶埃姆林替多麗絲看病。于爾根在確認治療方案後同意讓祖母試藥，病情轉好後，兩家仍維持鄰居間的往來。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-ee2d1170ed98.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "搬去南方",
        "prose": "于爾根原本打算帶祖母和布羅迪去南方度假。後來的消息提到，他為了多麗絲太太的病搬往南方，離開了與克萊恩相鄰的住處。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-ee2d1170ed98.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
