  "narrative_biography": {
    "schema_version": "1.0",
    "title": "阿芒迪娜｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "棕櫚莊園的女兒",
        "prose": "阿芒迪娜是佩蒂特爵士與西蒙娜夫人的女兒，在南大陸長大。她曾在未婚夫羅伯特面前觸摸黑色古墓，從此可以強制他人入夢，卻一直沒有把這份能力公開給當地的官方非凡者。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-b6b14eaad5eb.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "帶路前往古墓",
        "prose": "盧米安調查蒂扎莫鎮的夢節時，請她在夢中向卡利神甫問清古墓的來歷。由於接近古墓需要受過恩賜的人帶路，她隨後帶眾人穿過雨林，見到古墓周圍愈來愈清晰的往事幻象。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-b6b14eaad5eb.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "尋求黑夜途徑的力量",
        "prose": "夢節之後，阿芒迪娜與盧米安保持通信，也透過瑞雅接觸當地神秘學圈。她把恩賜的來源冥道人視為老師，並在芙蘭卡與倫納德等人的協助下尋求黑夜途徑的配方和材料。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-b6b14eaad5eb.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
