  "narrative_biography": {
    "schema_version": "1.0",
    "title": "安德森·胡德｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "獵人出身的冒險者",
        "prose": "安德森·胡德以經驗豐富的冒險家與獵人途徑非凡者身份活動，口才與挑釁能力相當突出。他擅長在危險環境中抓住機會，也常因自己的話惹出額外麻煩。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-08b0679523be.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "海上與遺跡經驗",
        "prose": "長期冒險使他熟悉海上勢力、神秘遺跡和不同非凡組織的規矩。他不像教會官方人員必須遵守嚴密制度，卻也因此要自己承擔選擇的後果。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-08b0679523be.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "與格爾曼的合作",
        "prose": "格爾曼·斯帕羅出海時曾與安德森接觸，兩人一個寡言且行動極具威懾力，一個善於用言語試探局勢。互相利用情報與共同處理危險，讓安德森成為主角海上經歷的鮮明陪襯。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-08b0679523be.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 4,
        "title": "獵人途徑的競爭",
        "prose": "其途徑特性讓他常要面對挑釁、陰謀和力量競爭相關任務。第四紀紅祭司權柄及梅迪奇等古老存在的影響，亦可能在後期與他的道路形成交集；具體序列必須按章節校對。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-08b0679523be.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
