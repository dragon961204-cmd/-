  "historical_sections": [
    {
      "part": 1,
      "title": "冒險家",
      "summary": "安德森活躍於海上和探險者圈子，熱衷見識各種異常事物與新奇危險。",
      "verification": "secondary_reference"
    },
    {
      "part": 2,
      "title": "獵人途徑",
      "summary": "他的非凡道路與挑釁、戰鬥及生存能力相關，性格與能力常相互強化。",
      "verification": "secondary_reference"
    },
    {
      "part": 3,
      "title": "海上的名聲",
      "summary": "因行為方式與競爭關係，他受到部分海盜敵視，也藉此留下強烈名聲。",
      "verification": "secondary_reference"
    },
    {
      "part": 4,
      "title": "與格爾曼的相遇",
      "summary": "他在克萊恩海上歷程中出現，提供不同於達尼茲的冒險家視角。",
      "verification": "secondary_reference"
    },
    {
      "part": 5,
      "title": "中後期主線",
      "summary": "其後來與戰爭及高序列安排相關的事件需按原作追查，不能把傳聞當完整生平。",
      "verification": "secondary_reference"
    }
  ],
