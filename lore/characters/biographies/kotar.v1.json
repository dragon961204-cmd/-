  "narrative_biography": {
    "schema_version": "1.0",
    "title": "科塔爾｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "第二紀的願望之神",
        "prose": "科塔爾是古神弗雷格拉麾下的從神，後世也以烏黯魔狼稱呼祂。弗雷格拉隕落後，祂以奇蹟師的力量在神棄之地活動，多年躲避阿蒙的追獵，也曾出現在月城探索隊抵達的地域。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-6d30b83d8f7b.html",
          "https://lordofthemysteries.fandom.com/wiki/Kotar"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "古堡中的追獵",
        "prose": "克萊恩需要奇蹟師的非凡特性，便循黑夜女神提供的線索找上科塔爾，並在蕾妮特的協助下闖入祂所在的古堡。科塔爾最終逃離，留下所控制的幕布和部分戰利品。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-6d30b83d8f7b.html",
          "https://lordofthemysteries.fandom.com/wiki/Kotar"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "克萊恩晉升後",
        "prose": "克萊恩把科塔爾的血用作晉升奇蹟師的輔助材料。之後科塔爾察覺克萊恩的氣息便會遠遠避開，祂在神棄之地的行動也轉以躲避追蹤為主。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-6d30b83d8f7b.html",
          "https://lordofthemysteries.fandom.com/wiki/Kotar"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
