  "historical_sections": [
    {
      "part": 1,
      "title": "魯恩王室",
      "summary": "喬治三世為魯恩國王，其統治涉及貴族議會、海外殖民地與教會間的政治平衡。",
      "verification": "secondary_reference"
    },
    {
      "part": 2,
      "title": "秘密非凡野心",
      "summary": "他暗中追求黑皇帝途徑晉升，必須建造符合儀式要求的陵寢。",
      "verification": "secondary_reference"
    },
    {
      "part": 3,
      "title": "地下同盟",
      "summary": "其計畫與黃昏隱士會、魔女教派及極光會等勢力交會，但聯盟不等同公開的正式入會。",
      "verification": "secondary_reference"
    },
    {
      "part": 4,
      "title": "貝克蘭德事件",
      "summary": "社會底層受到政治與秘密事件影響；其公開王室形象與幕後計畫需要分開給玩家。",
      "verification": "secondary_reference"
    },
    {
      "part": 5,
      "title": "1350年結局",
      "summary": "第一部第1148章的儀式事件與其死亡相關，這會改變魯恩政治與世界戰爭的後續狀態。",
      "verification": "secondary_reference"
    }
  ],
