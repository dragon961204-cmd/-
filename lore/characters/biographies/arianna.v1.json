      "part": 1,
      "title": "教會高層",
      "summary": "阿里安娜是黑夜女神教會高位人物，負責重要的宗教與隱秘事務。",
      "verification": "secondary_reference"
    },
    {
      "part": 2,
      "title": "非凡能力",
      "summary": "她具有黑暗途徑的高位能力，與普通值夜者的工作層級完全不同。",
      "verification": "secondary_reference"
    },
    {
      "part": 3,
      "title": "神諭與行動",
      "summary": "她的重大行動受教會長期規劃與女神旨意影響，通常需要保密。",
      "verification": "secondary_reference"
    },
    {
      "part": 4,
      "title": "與克萊恩的接觸",
      "summary": "第一部後期她向克萊恩提供協助與重要警告，但這些屬高層事件，不適合提前放在1349年廷根序章。",
      "verification": "secondary_reference"
    },
    {
      "part": 5,
      "title": "宇宙危機",
      "summary": "她與宇宙知識、污染和非凡者認知風險相關的資訊需設置嚴格知情門檻。",
      "verification": "secondary_reference"
    }
