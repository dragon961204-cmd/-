  "historical_sections": [
    {
      "part": 1,
      "title": "亞伯拉罕後裔",
      "summary": "多里安出身曾經顯赫的亞伯拉罕家族，家族衰弱與滿月詛咒影響其非凡成長。",
      "verification": "secondary_reference"
    },
    {
      "part": 2,
      "title": "普利茲港的生活",
      "summary": "他在普利茲港一帶活動，管理若干家族財產並維繫剩餘的族人網絡。",
      "verification": "secondary_reference"
    },
    {
      "part": 3,
      "title": "傳承的責任",
      "summary": "他知道學徒途徑及家族傳承的重要性，也因歷史事件對收徒和傳授秘密保持警惕。",
      "verification": "secondary_reference"
    },
    {
      "part": 4,
      "title": "佛爾思的老師",
      "summary": "佛爾思將勞倫斯的遺物交還之後，逐漸建立師徒關係。",
      "verification": "secondary_reference"
    },
    {
      "part": 5,
      "title": "家族詛咒的後續",
      "summary": "其未來決策與門先生、家族復興及佛爾思的成長相連，應依小說事件時間推進。",
      "verification": "secondary_reference"
    }
  ],
