  "historical_sections": [
    {
      "part": 1,
      "title": "第二紀血脈",
      "summary": "安提哥努斯是魔狼弗雷格拉的子嗣，與天之母親具有家族關係。",
      "verification": "secondary_reference"
    },
    {
      "part": 2,
      "title": "第四紀家族",
      "summary": "其家族以占卜家途徑在帝國政治與神秘世界佔有重要地位。",
      "verification": "secondary_reference"
    },
    {
      "part": 3,
      "title": "半個愚者",
      "summary": "他容納愚者途徑唯一性，成為『半個愚者』，但狀態受古老意志的影響。",
      "verification": "secondary_reference"
    },
    {
      "part": 4,
      "title": "霍納奇斯山脈",
      "summary": "失控後被封印於霍納奇斯山脈相關區域，第一部的早期筆記及囈語都會引出這條歷史線。",
      "verification": "secondary_reference"
    },
    {
      "part": 5,
      "title": "後期轉折",
      "summary": "其力量與身分在克萊恩晉升過程中產生重大變化，不能用第四紀位格覆蓋第五紀結局。",
      "verification": "secondary_reference"
    }
  ],
