  "historical_sections": [
    {
      "part": 1,
      "title": "大地母神教會背景",
      "summary": "弗蘭克早期受大地母神教會影響，擁有種植與農業相關非凡道路的背景。",
      "verification": "secondary_reference"
    },
    {
      "part": 2,
      "title": "未來號的船醫",
      "summary": "他擔任嘉德麗雅船上的醫生與大副，將航海生活和超凡植物研究結合。",
      "verification": "secondary_reference"
    },
    {
      "part": 3,
      "title": "強烈的研究興趣",
      "summary": "他持續研究土壤、蘑菇及生物培養，想透過創新解決生產與食物問題。",
      "verification": "secondary_reference"
    },
    {
      "part": 4,
      "title": "與克萊恩的合作",
      "summary": "克萊恩試圖把他的研究引導到可為神棄之地居民提供食物的方向。",
      "verification": "secondary_reference"
    },
    {
      "part": 5,
      "title": "後期植物成果",
      "summary": "其發明逐漸影響新白銀城的生活；序列晉升記錄必須遵循具體原作章節。",
      "verification": "secondary_reference"
    }
  ],
