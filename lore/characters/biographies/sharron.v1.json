  "historical_sections": [
    {
      "part": 1,
      "title": "人物起點",
      "summary": "莎倫曾隸屬玫瑰學派相關傳承，反對放縱派的理念與統治，與馬里奇共同離開主流組織。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "她在貝克蘭德以秘密委託與非凡交易維持活動，要求合作方守約並尊重危險的保密規則。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "與蕾妮特·緹尼科爾的關係使其具有組織歷史與高序列線索，但不應因此免於放縱派追查。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "她與克萊恩的合作逐步累積相互信任，後續組織發展需按二部時序更新。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "玩家可追查地下聚會、縱慾派追捕與非凡特性交易，不能創角直接加入節制派。",
      "verification": "needs_original_chapter"
    }
  ],
