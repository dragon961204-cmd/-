  "historical_sections": [
    {
      "part": 1,
      "title": "人物起點",
      "summary": "貝爾納黛是羅塞爾的女兒，成長於因蒂斯政局和父親技術革新的背景之下；童年家庭記憶影響她後來的選擇。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "羅塞爾遭刺殺後，她延續對父親的疑問，依靠神秘學知識和海上活動逐步接近他留下的秘密。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "建立要素黎明並以神秘女王身分活動，和嘉德麗雅的師徒關係並不總是單純的命令服從。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "她與黑皇帝、外神污染及日記有關的知識屬高階機密。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "透過航海、要素黎明或羅塞爾遺物與其間接聯繫。",
      "verification": "needs_original_chapter"
    }
  ],
