  "narrative_biography": {
    "schema_version": "1.0",
    "title": "梅高歐絲｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "被蘭爾烏斯欺騙",
        "prose": "梅高歐絲是廷根居民，被蘭爾烏斯騙成未婚妻。蘭爾烏斯請胡德·歐根協助舉行儀式，利用她孕育真實造物主的子嗣；她的家人則因鐵礦投資被騙，曾帶她到占卜俱樂部求助。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-2ea2fbfc75d5.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "走進黑荊棘安保公司",
        "prose": "懷孕七個多月時，她在0-08的安排下來到值夜者所在的黑荊棘安保公司。異變爆發後，鄧恩等人為阻止邪神子嗣降臨而迎戰，梅高歐絲與胎兒最終一同被消滅。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-2ea2fbfc75d5.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "身後留下的線索",
        "prose": "這場戰鬥也使鄧恩犧牲。克萊恩後來推測因斯帶走了胎兒留下的臍帶；追上因斯復仇時，他仍記得梅高歐絲在廷根事件中所受的傷害。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-2ea2fbfc75d5.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
