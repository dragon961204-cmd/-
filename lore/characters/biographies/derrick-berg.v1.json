  "historical_sections": [
    {
      "part": 1,
      "title": "人物起點",
      "summary": "戴里克生活於被神棄之地的白銀城，居民長期在黑暗中求生，世代依靠嚴格守夜與非凡者制度延續社群。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "以太陽身分加入灰霧聚會，對外界地理、金錢和教會制度的認識與南北大陸成員完全不同。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "在探索隊、城邦議事團及墮落危機中逐漸成熟，必須面對同胞生存、信仰與真相的衝突。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "尋找離開黑暗世界的道路不只是個人成長，而是整個城市的政治與宗教抉擇。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "白銀城必須是獨立地圖系統；普通1349年北大陸玩家不能無條件進入。",
      "verification": "needs_original_chapter"
    }
  ],
