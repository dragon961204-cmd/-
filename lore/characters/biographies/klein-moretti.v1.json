{
  "schema_version": "1.0",
  "character_id": "klein-moretti",
  "name_zh": "克萊恩·莫雷蒂",
  "biography_level": "A_or_B",
  "status": "expanded_draft",
  "scope": "原作兩部可用；人物每個時間點狀態須另核實",
  "long_summary": "廷根歷史系畢業生經歷神祕事件後，周明瑞以其身分醒來。在家庭生計、值夜者工作和追索穿越真相之間，他逐步建立自己的非凡生存策略。後續以不同身分在貝克蘭德與海上活動，並藉灰霧聚會建立塔羅會；最終涉及世界級的源質與外神危機。",
  "historical_sections": [
    {
      "sequence": 1,
      "title": "莫雷蒂家的日常",
      "summary": "與兄長班森、妹妹梅麗莎同住，具歷史學教育背景；家庭負擔與工作選擇使他在早期不是脫離世俗的冒險者。",
      "source_ids": [
        "timeline",
        "klein",
        "kleinProgress"
      ],
      "verification": "secondary_source",
      "spoiler_level": "medium"
    },
    {
      "sequence": 2,
      "title": "神祕筆記與身分轉變",
      "summary": "韋爾奇、娜婭與安提哥努斯家族筆記引發的異常事件，是周明瑞在1349年6月28日醒來的直接敘事起點。",
      "source_ids": [
        "timeline",
        "klein",
        "kleinProgress"
      ],
      "verification": "secondary_source",
      "spoiler_level": "medium"
    },
    {
      "sequence": 3,
      "title": "值夜者的招募",
      "summary": "與鄧恩、倫納德和戴莉接觸後，克萊恩從接受調查到成為黑荊棘安保公司文職，並接觸老尼爾的神秘學教育。",
      "source_ids": [
        "timeline",
        "klein",
        "kleinProgress"
      ],
      "verification": "secondary_source",
      "spoiler_level": "medium"
    },
    {
      "sequence": 4,
      "title": "灰霧與塔羅會",
      "summary": "透過灰霧的特殊聯繫，他與奧黛麗、阿爾傑建立神秘聚會；其對外形象與現實身份必須嚴格隔離。",
      "source_ids": [
        "timeline",
        "klein",
        "kleinProgress"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    },
    {
      "sequence": 5,
      "title": "占卜家的晉升",
      "summary": "1349年7月2日成為序列9占卜家；扮演法、消化、魔藥配方和隊伍調查逐漸成為成長主軸。",
      "source_ids": [
        "timeline",
        "klein",
        "kleinProgress"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    },
    {
      "sequence": 6,
      "title": "廷根之變",
      "summary": "與因斯安排的陰謀和小隊的重大危機牽連，促成克萊恩離開原本的生活並改換身份。",
      "source_ids": [
        "timeline",
        "klein",
        "kleinProgress"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    },
    {
      "sequence": 7,
      "title": "貝克蘭德偵探",
      "summary": "以夏洛克·莫里亞蒂身分調查委託、接觸社會各階層，尋找仇敵和魔藥線索。",
      "source_ids": [
        "timeline",
        "klein",
        "kleinProgress"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    },
    {
      "sequence": 8,
      "title": "格爾曼·斯帕羅與海上",
      "summary": "出海後使用冒險家身分追查非凡材料和秘密，與海盜、非凡組織建立複雜關係。",
      "source_ids": [
        "timeline",
        "klein",
        "kleinProgress"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    },
    {
      "sequence": 9,
      "title": "道恩·唐泰斯及高序列",
      "summary": "回到貝克蘭德後使用新的社交身分，逐步接觸教會高層、隱秘存在與第四紀遺產。",
      "source_ids": [
        "timeline",
        "klein",
        "kleinProgress"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    },
    {
      "sequence": 10,
      "title": "愚者與末日",
      "summary": "成長為高位存在後，私人尋鄉與守護人性的目標，同世界末日和外神威脅交織；遊戲早期不可公開高序列結果。",
      "source_ids": [
        "timeline",
        "klein",
        "kleinProgress"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    }
  ],
