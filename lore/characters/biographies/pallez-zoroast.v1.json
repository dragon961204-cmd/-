  "historical_sections": [
    {
      "part": 1,
      "title": "人物起點",
      "summary": "帕列斯來自第四紀的索羅亞斯德家族，擁有錯誤途徑的長久經歷，也因此與阿蒙結怨。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "在倫納德體內寄居，初期主要透過提醒和隱藏知識影響宿主行動。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "他的安全考量常與倫納德的衝動及教會職責發生張力；並非任何時候都願意公開出手。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "隨克萊恩與倫納德的成長，其生存策略與塔羅會的關係逐漸變化。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "1349年的玩家不應直接看到帕列斯角色欄；只有特殊識別、情報與事件能揭示。",
      "verification": "needs_original_chapter"
    }
  ],
