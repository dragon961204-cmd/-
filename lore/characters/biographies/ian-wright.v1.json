  "narrative_biography": {
    "schema_version": "1.0",
    "title": "伊恩·賴特｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "替偵探跑腿的少年",
        "prose": "伊恩曾在街頭流浪，自稱被偵探澤瑞爾收養，後來替他蒐集情報。澤瑞爾失蹤後，伊恩在蒸汽地鐵躲避追捕時遇見剛到貝克蘭德的克萊恩，委託他確認偵探的下落。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-27a30707e737.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "差分機手稿案",
        "prose": "克萊恩帶伊恩到下水道認屍，失蹤案也由此牽出第三代差分機手稿的爭奪。伊恩之後把手稿下落交給軍情九處，並向克萊恩道歉，說明自己如何讓他捲入其中。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-27a30707e737.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "在勇敢者酒吧做情報生意",
        "prose": "在普利茲港待過一段時間後，伊恩回到貝克蘭德，以勇敢者酒吧的桌球室為據點販賣情報和軍火。埃姆林後來多次在此找他打聽秘密信徒和南大陸來客。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-27a30707e737.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
