  "narrative_biography": {
    "schema_version": "1.0",
    "title": "邁克·約瑟夫｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "從連環命案認識夏洛克",
        "prose": "邁克是貝克蘭德記者，經塔利姆介紹認識克萊恩。他準備深入報導連環殺人案，便雇夏洛克陪他訪查死者希貝爾工作過的地方，並追究這起死亡是否出自模仿犯。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-f1641d6f0946.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "走進東區的工廠",
        "prose": "邁克後來調查東區、碼頭和工廠區的勞動環境，與夏洛克換上工人衣服，請老科勒帶路。他們避開看守進入鉛白工廠，邁克把親眼所見的工作環境和居民生活寫入調查手稿。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-f1641d6f0946.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "霧霾之後仍追蹤受害者",
        "prose": "大霧霾後，克萊恩匿名寫信請邁克關照失去家人的黛西。邁克後來又與道恩·唐泰斯接觸，提供他在兩家報社的廣告渠道，兩次認識的對象其實都是克萊恩。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-f1641d6f0946.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
