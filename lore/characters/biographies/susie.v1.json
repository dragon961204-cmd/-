      "part": 1,
      "title": "霍爾家中的金毛犬",
      "summary": "蘇茜原是奧黛麗的寵物，在貴族家庭環境中生活，不能把她當成人類社交圈的普通成員。",
      "verification": "secondary_reference"
    },
    {
      "part": 2,
      "title": "意外成為非凡生物",
      "summary": "因誤飲觀眾魔藥，她成為能夠思考和學習的非凡犬類。",
      "verification": "secondary_reference"
    },
    {
      "part": 3,
      "title": "奧黛麗的伙伴",
      "summary": "她與奧黛麗形成信任關係，早期常在旁聽、觀察和保護方面提供協助。",
      "verification": "secondary_reference"
    },
    {
      "part": 4,
      "title": "成長中的心理學知識",
      "summary": "隨晉升而逐漸掌握更高階的觀察與心理能力，後期具備專業心理輔助能力。",
      "verification": "secondary_reference"
    },
    {
      "part": 5,
      "title": "第二部的角色",
      "summary": "她在第二部與盧米安的心理治療線有關；不同年份的序列必須分開記錄。",
      "verification": "secondary_reference"
    }
  ],
