  "narrative_biography": {
    "schema_version": "1.0",
    "title": "布里涅爾男爵｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "薩瓦黨的放貸人",
        "prose": "布里涅爾是特里爾市場區的薩瓦黨頭目，以放高利貸和打理微風舞廳維持幫派收入。他發現被通緝的盧米安後先派人跟蹤，得知手下遭制伏，才當面警告盧米安別損害薩瓦黨的利益。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-4a41fd0b0807.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "從監視到引介",
        "prose": "男爵沒有立即把盧米安交給警方，反而在看出他的能力後，把他帶去見首領加德納。加德納把微風舞廳交給盧米安，原本由男爵掌管的地盤就此轉手。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-4a41fd0b0807.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "路德維希的教父",
        "prose": "男爵信仰知識與智慧之神，也是路德維希的教父。盧米安後來經由他接觸這名外表年幼的孩子；路德維希離開特里爾前，一直以男爵教子的身分在城裡生活。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-4a41fd0b0807.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
