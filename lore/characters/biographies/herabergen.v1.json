  "narrative_biography": {
    "schema_version": "1.0",
    "title": "赫拉伯根｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "智慧之龍與智天使",
        "prose": "赫拉伯根原是古代巨龍一方的從神，曾追隨空想之龍安格爾威德，後以智天使的身分侍奉遠古太陽神。太陽神隕落時，祂與風天使、純白天使瓜分舊主的部分權柄。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-fb8730bf5918.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "成為倫堡等地的正神",
        "prose": "赫拉伯根取得白塔神位，以知識與智慧之神的稱號受倫堡等國崇拜。第五紀時，克萊恩逐步察覺祂在《格羅塞爾遊記》事件中的作用，也從祂手上取得打開一處宮殿所需的鑰匙。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-fb8730bf5918.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "title": "摩羅拉的人偶大主教",
        "prose": "赫拉伯根在摩羅拉以赫拉貝格的身分活動，擔任知識教會的大主教。祂替盧米安指定讀物、出考題，還把書本知識提取到黃銅薄片裡。到了末日前夕，祂向盧米安說明，摩羅拉與周邊山脈實際位於祂的胃袋中。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-d2bda14a9315.html",
          "https://lordofthemysteries.fandom.com/wiki/God_of_Knowledge_and_Wisdom"
        ],
        "chapter_range": {
          "book": "coi",
          "start": 793,
          "end": 1128
        },
        "status": "original_narrative_draft_pending_user_review",
        "part": 3
      },
      {
        "part": 4,
        "title": "從神國對抗到融合",
        "prose": "亞當試圖重聚權柄時，赫拉伯根曾與另外兩位真神一同被壓制在神國。到了《宿命之環》末期，祂選擇自我毀滅，最終與格里沙·亞當融合。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-fb8730bf5918.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
