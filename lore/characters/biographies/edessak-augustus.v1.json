  "narrative_biography": {
    "schema_version": "1.0",
    "title": "埃德薩克·奧古斯都｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "王子與馬術教師",
        "prose": "埃德薩克在塔利姆擔任馬術教師時認識他。塔利姆暴斃後，他把遺物和頭髮等材料交給私家偵探夏洛克，委託對方查明死因；克萊恩雖查到詛咒的痕跡，對王子仍以突發心臟疾病作結。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-3a5669dab6b7.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "特莉絲進入紅薔薇莊園",
        "prose": "魔女教派安排特莉絲接近王子，兩人後來成為情人。埃德薩克知道她是魔女，也曾質問她為何想逃；王子身邊的活動因此與教派及大霧霾前的布局交疊。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-3a5669dab6b7.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "舉槍與身後的追查",
        "prose": "王子最終在莊園以能傷及靈體的子彈自盡。喬治三世對外稱他涉入謀反，特莉絲則一直追查他是否遭人逼迫。王室公告、特莉絲的判斷及其他人的說法，各自反映了此案不同的知情範圍。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-3a5669dab6b7.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
