      "part": 1,
      "title": "白銀城長老",
      "summary": "洛薇雅作為六人議事團成員，參與城市在黑暗環境中的重大決策。",
      "verification": "secondary_reference"
    },
    {
      "part": 2,
      "title": "失去親人的探索",
      "summary": "她曾在危險探索中失去丈夫，這段經歷引發居民對她的猜疑與爭議。",
      "verification": "secondary_reference"
    },
    {
      "part": 3,
      "title": "真實造物主信仰",
      "summary": "她相信真實造物主可能為白銀城帶來希望，但其秘密信仰也帶來污染及政治風險。",
      "verification": "secondary_reference"
    },
    {
      "part": 4,
      "title": "對城邦的忠誠",
      "summary": "她的宗教立場與議事團不同，卻不能因此簡化為毫無城邦歸屬感的叛徒。",
      "verification": "secondary_reference"
    },
    {
      "part": 5,
      "title": "後期遠征",
      "summary": "她在重要探索中扮演關鍵角色，與白銀城逃離黑暗的願望相連。",
      "verification": "secondary_reference"
    }
