  "name_zh": "鄧恩·史密斯",
  "biography_level": "A_or_B",
  "status": "expanded_draft",
  "scope": "原作兩部可用；人物每個時間點狀態須另核實",
  "long_summary": "黑夜女神教會廷根值夜者隊長，將守護市民和隊員的責任放在日常行動之中。他招募並訓練克萊恩，與戴莉有深刻情感聯繫；廷根危機是其人物結局的中心。",
  "historical_sections": [
    {
      "sequence": 1,
      "title": "教會訓練",
      "summary": "走上不眠者途徑，作為黑夜女神教會的非凡者服務，逐漸熟悉處理失控與超自然案件的職責。",
      "source_ids": [
        "dunn",
        "tingen",
        "timeline"
      ],
      "verification": "secondary_source",
      "spoiler_level": "medium"
    },
    {
      "sequence": 2,
      "title": "廷根小隊隊長",
      "summary": "在黑荊棘安保公司的掩護下統籌值夜者，需同時處理文書、偵查、封印物及隊員安全。",
      "source_ids": [
        "dunn",
        "tingen",
        "timeline"
      ],
      "verification": "secondary_source",
      "spoiler_level": "medium"
    },
    {
      "sequence": 3,
      "title": "夢魘能力",
      "summary": "身為序列7夢魘，他能透過夢境相關手段調查；精神與記憶方面的表現同途徑影響相關。",
      "source_ids": [
        "dunn",
        "tingen",
        "timeline"
      ],
      "verification": "secondary_source",
      "spoiler_level": "medium"
    },
    {
      "sequence": 4,
      "title": "克萊恩的招募",
      "summary": "調查筆記事件之後，給予克萊恩選擇是否加入官方隊伍的機會，並安排非凡知識教育。",
      "source_ids": [
        "dunn",
        "tingen",
        "timeline"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    },
    {
      "sequence": 5,
      "title": "小隊的人情",
      "summary": "與倫納德、弗萊、老尼爾等各有不同工作關係，與戴莉的私人感情不能簡化為純職務。",
      "source_ids": [
        "dunn",
        "tingen",
        "timeline"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    },
    {
      "sequence": 6,
      "title": "安提哥努斯筆記線",
      "summary": "小隊追查筆記和相關危險時，需要受教會紀律約束，並無法事先洞悉高層陰謀。",
      "source_ids": [
        "dunn",
        "tingen",
        "timeline"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    },
    {
      "sequence": 7,
      "title": "因斯的布局",
      "summary": "0-08能改變事件的連鎖發展，鄧恩在廷根所面對的是超出一般調查規模的系統性威脅。",
      "source_ids": [
        "dunn",
        "tingen",
        "timeline"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    },
    {
      "sequence": 8,
      "title": "廷根重大事件",
      "summary": "1349年9月9日隊伍處理迫近的非凡危機，鄧恩的犧牲成為倫納德與克萊恩後續行動的重要動因。",
      "source_ids": [
        "dunn",
        "tingen",
        "timeline"
      ],
      "verification": "secondary_source",
      "spoiler_level": "high"
    }
  ],
