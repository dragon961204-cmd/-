  "narrative_biography": {
    "schema_version": "1.0",
    "title": "路德維爾｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "黑色鬱金香號的船長",
        "prose": "路德維爾以地獄上將之名統領黑色鬱金香號，經常出現在其他海盜避開的危險航路。他曾襲擊克萊恩，戰後讓座船經由青銅大門遁走；他手上的戒指也讓克萊恩開始向阿茲克打聽死神的遺物。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-f97d917f54f9.html",
          "https://lordofthemysteries.fandom.com/wiki/Ludwell"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "向死亡執政官低頭",
        "prose": "阿茲克與克萊恩登上黑色鬱金香號時，路德維爾認出了死亡執政官，當著船員的面放棄抵抗。克萊恩控制他的靈體之線後，米雷拉接手他的船隊。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-f97d917f54f9.html",
          "https://lordofthemysteries.fandom.com/wiki/Ludwell"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "離開海盜船之後",
        "prose": "成為祕偶的路德維爾跟隨克萊恩探索靈界與卡爾德隆，也和恩佐一起參與對付因斯的行動。他離開船隊後的經歷，都是克萊恩藉祕偶執行的任務。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-f97d917f54f9.html",
          "https://lordofthemysteries.fandom.com/wiki/Ludwell"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
