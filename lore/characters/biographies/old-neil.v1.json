        "timeline"
      ],
      "verification": "secondary_source",
      "spoiler_level": "medium"
    },
    {
      "sequence": 3,
      "title": "轉任文職",
      "summary": "隨年齡與身體狀況改變，不再適合頻繁外勤，留在黑荊棘安保公司整理資料。",
      "source_ids": [
        "oldNeil",
        "timeline"
      ],
      "verification": "secondary_source",
      "spoiler_level": "medium"
    },
    {
      "sequence": 4,
      "title": "教導克萊恩",
      "summary": "以日常課程介紹儀式魔法、靈視、符號等入門知識，亦讓克萊恩接觸羅塞爾的日記。",
