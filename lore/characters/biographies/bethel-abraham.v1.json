  "historical_sections": [
    {
      "part": 1,
      "title": "第三與第四紀",
      "summary": "伯特利是亞伯拉罕家族的古老先祖，因門途徑權柄與第四紀帝國史相連。",
      "verification": "secondary_reference"
    },
    {
      "part": 2,
      "title": "門先生",
      "summary": "他在第四紀四皇之戰後被放逐至與現實隔絕的空間，其求救聲影響亞伯拉罕家族的後代。",
      "verification": "secondary_reference"
    },
    {
      "part": 3,
      "title": "家族的詛咒",
      "summary": "每逢滿月的異常呼喚使家族非凡者長期承受風險，也塑造了多里安等後裔的命運。",
      "verification": "secondary_reference"
    },
    {
      "part": 4,
      "title": "與佛爾思的間接聯繫",
      "summary": "佛爾思透過家族傳承與滿月異象觸及他的線索，但早期並不知道整體真相。",
      "verification": "secondary_reference"
    },
    {
      "part": 5,
      "title": "歸來與抉擇",
      "summary": "第一部第1353章附近的事件涉及其返回、外神污染與關鍵抉擇，應作世界級時間節點。",
      "verification": "secondary_reference"
    }
