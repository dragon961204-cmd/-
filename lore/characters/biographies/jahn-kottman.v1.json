  "narrative_biography": {
    "schema_version": "1.0",
    "title": "亞恩·考特曼｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "鎮守羅思德海域",
        "prose": "考特曼是風暴教會的樞機主教，也是羅思德海域大主教兼代罰者高階執事。他從水手途徑晉升到序列3海王，在拜亞姆的海浪教堂主持教區事務。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-621430cc602f.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "對抗群島的海神",
        "prose": "卡維圖瓦失控掀起海嘯時，考特曼出手阻止。海蛇死後，他判斷取走遺留特性的人還在群島附近，便命代罰者追查異常，並在拜亞姆城外介入涉及玫瑰學派高位力量的戰鬥。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-621430cc602f.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "主持阿爾傑的晉升",
        "prose": "阿爾傑把高希納姆遺物一事上報後，通過風暴教會的樞機會議審核，獲准由考特曼主持晉升。當地反抗軍考慮與教會談判時，也把考特曼視為有權作最後決定的人。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-621430cc602f.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
