  "narrative_biography": {
    "schema_version": "1.0",
    "title": "伊康瑟·伯納德｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "機械之心與阿羅德斯",
        "prose": "伊康瑟是蒸汽與機械教會的機械之心成員，在貝克蘭德負責非凡案件。調查欲望使徒和阿蒙家族陵墓等異常時，他曾借助魔鏡阿羅德斯取證，也得按魔鏡的規矩回答它提出的私人問題。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-37ae8be05456.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "追查夏洛克·莫里亞蒂",
        "prose": "大霧霾後，機械之心循相關案件追查失蹤的私家偵探夏洛克。伊康瑟透過阿羅德斯打聽此人，卻受魔鏡與克萊恩的私下關係影響，難以靠它取得完整答案。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-37ae8be05456.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "繼續看管魔鏡",
        "prose": "到了第一部後期，伊康瑟仍負責阿羅德斯的保管。魔鏡能向教會提供案件線索，也能在教會視線之外主動與克萊恩聯繫。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-37ae8be05456.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
