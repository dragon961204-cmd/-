      "part": 1,
      "title": "人物起點",
      "summary": "休的家族因政治事件失勢，她在貝克蘭德底層地區活動，以調解糾紛、調查和委託養活自己。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "與佛爾思共同生活並建立長期信任，在接觸非凡世界後探索審判者途徑。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "追查家族舊案與權力關係，是她接近情報圈及官方機構的重要動機。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "以審判牌加入塔羅會後，逐步承擔更高層的官方與非凡責任。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "玩家可從地方調解、貧民區糾紛和失勢貴族相關案件認識她。",
      "verification": "needs_original_chapter"
    }
  ],
