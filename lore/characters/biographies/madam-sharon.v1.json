  "narrative_biography": {
    "schema_version": "1.0",
    "title": "雪倫夫人｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "霍伊家族的遺孀",
        "prose": "雪倫夫人原本是男性，服下女巫魔藥後成為女性，並在魔女教派活動。她以霍伊家族老男爵遺孀的身分進入廷根上層，長期替政界與商界人士牽線，私下則已晉升歡愉魔女。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-f87a97653596.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "殺害梅納德議員",
        "prose": "她為了加深新黨與保守黨的對立，殺死新黨議員梅納德，對警方稱他猝死。梅納德夫人另請黑荊棘安保公司查案，克萊恩潛入雪倫的住所，從占卜與保險櫃裡的物品找到非凡線索。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-f87a97653596.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "在圍捕中身亡",
        "prose": "鄧恩、肯利與克萊恩一同前往圍捕。肯利在行動中犧牲，克萊恩最後開槍殺死雪倫，並於事後通靈取得歡愉魔藥的配方。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-f87a97653596.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
