      "part": 1,
      "title": "人物起點",
      "summary": "烏洛琉斯是命運途徑的高位存在，長期追隨真實造物主，並與古代神靈史有聯繫。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "他與威爾的競爭構成命運領域重要衝突，其行為動機不宜簡化成普通極光會成員。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "不同时期不同陣營的政治變化需要以具體劇情核實；其沉默與順從不代表缺乏自主目標。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "玩家一般應先透過神秘符號、預言及極光會高階傳聞得知他。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "設定高階世界事件，不可在普通地下聚會隨意提供晉升材料。",
      "verification": "needs_original_chapter"
    }
  ],
