  "narrative_biography": {
    "schema_version": "1.0",
    "title": "薩林格爾｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "從拜朗冥皇到死神",
        "prose": "薩林格爾曾是古代不死鳥一方的從神，後來取得死神權柄，成為拜朗帝國的冥皇。阿茲克曾以死亡執政官的身分服務於這個帝國；他在第五紀追尋自身記憶時，也逐步揭開自己與死神的父子關係。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-8653377d38f9.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "蒼白年代的戰爭",
        "prose": "四皇之戰後，薩林格爾嘗試將死神和紅祭司的力量結合。他與原初魔女掀起蒼白之災，最終在北大陸諸神的反擊中隕落。拜朗帝國瓦解後，南大陸各方仍有人試圖借他的遺產重建權力。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-8653377d38f9.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "死神唯一性的去向",
        "prose": "靈教團部分成員嘗試以儀式造出人造死神。黑夜女神循這條線介入，阿茲克也因身世與靈魂中的安排再次牽涉其中。薩林格爾死後，圍繞其唯一性和冥界的爭奪仍延續到兩部作品。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-8653377d38f9.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
