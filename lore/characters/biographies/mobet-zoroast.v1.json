  "narrative_biography": {
    "schema_version": "1.0",
    "title": "莫貝特·索羅亞斯德｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "第四紀失蹤的子爵",
        "prose": "莫貝特出身索羅亞斯德家族，是所羅門帝國的子爵、偷盜者途徑的竊夢家。帕列斯是他的曾祖父；一場戰爭後莫貝特失蹤，家族長久不知他被困在《格羅塞爾遊記》裡。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-27ed60b8615d.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "與夏塔絲並肩作戰",
        "prose": "莫貝特在書中與精靈夏塔絲成婚，並加入格羅塞爾的隊伍。在對付冰霜巨龍尤里斯安時，他偷走巨龍準備付諸行動的念頭，替同伴爭取進攻機會。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-27ed60b8615d.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "離書後與夏塔絲同葬",
        "prose": "尤里斯安死後，莫貝特和夏塔絲得以離開書中世界，卻很快衰老死去。艾德雯娜後來把兩人的遺骸帶往蘇尼亞島，葬在精靈遺跡一帶。倫納德其後也曾藉夏塔絲的夢向莫貝特的身影打聽帕列斯。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-27ed60b8615d.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
