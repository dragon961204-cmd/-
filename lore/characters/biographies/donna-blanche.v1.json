  "narrative_biography": {
    "schema_version": "1.0",
    "title": "堂娜｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "乘白瑪瑙號出海",
        "prose": "堂娜是烏爾迪·布蘭奇的女兒，跟著家人和弟弟丹頓乘船出海。她原本對海上的傳說充滿好奇，還向船長打聽不老泉，途中卻先遇上了海盜接近客船的危機。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-debb373e155b.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "帶著弟弟逃離班西港",
        "prose": "班西港起風時，堂娜從餐廳窗邊看見無頭的人影，驚慌之中一直握著丹頓的手。格爾曼帶著一行人前往風暴教堂避險，她也因此記住了這位在危險中幫助家人的冒險家。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-debb373e155b.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "替格爾曼辯護",
        "prose": "後來有人把格爾曼說成壞人和邪教徒，丹頓跑來告訴堂娜。她仍相信自己在班西港見到的那個人，對弟弟說斯帕羅叔叔是勇敢而善良的冒險家。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-debb373e155b.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
