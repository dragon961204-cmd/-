  "narrative_biography": {
    "schema_version": "1.0",
    "title": "塔利姆｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "家道中落的馬術教師",
        "prose": "塔利姆的祖上曾有子爵爵位，他這一代則靠教貴族騎馬謀生，因工作認識埃德薩克王子。瑪麗夫人請他引介夏洛克加入克拉格俱樂部，他和克萊恩後來常在那裡打牌、運動，也把記者邁克等人介紹給對方。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-29b349ed9952.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "王子的委託與詛咒",
        "prose": "塔利姆曾替大人物轉達追查卡平案中塔羅牌的委託，死前又頻繁出入紅薔薇莊園。他突然死亡後，克萊恩在灰霧之上透過染血手帕確認死因是詛咒。特莉絲後來說，她原想利用塔利姆逃走，卻在不明情況下用詛咒殺死了他。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-29b349ed9952.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
