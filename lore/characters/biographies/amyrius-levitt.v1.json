  "narrative_biography": {
    "schema_version": "1.0",
    "title": "艾彌留斯·利維特｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "利維特家的海軍上將",
        "prose": "艾彌留斯出身魯恩的利維特家族，兄長任上議院議員，弟弟奧斯頓曾是奧拉維島總督。他本人是序列4織法者，統率魯恩部署在中蘇尼亞海的海軍。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-e81c2e2eb881.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "奧拉維島的替身",
        "prose": "艾彌留斯需要秘密離開幾天，便透過比爾特聘請能改換外貌的格爾曼，以契約約束他的扮演並交付符咒。克萊恩代替他期間，既遇到奧斯頓失去總督職位的風波，也被迫處理辛西婭受污染後的異變。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-e81c2e2eb881.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "回到國防部",
        "prose": "艾彌留斯回來後聽取了克萊恩的報告，接受替身在突發事件中的處置。他隨後被調回貝克蘭德，失去海軍統帥一職，後來重新獲得任用，主導國防部事務。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-e81c2e2eb881.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
