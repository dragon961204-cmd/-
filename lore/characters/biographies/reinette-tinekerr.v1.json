  "historical_sections": [
    {
      "part": 1,
      "title": "人物起點",
      "summary": "蕾妮特是玫瑰學派節制派的重要高位存在，與學派內部重大分裂及放縱派敵對關係密切。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "她曾受到嚴重打擊，後以特殊靈體形式活動；四頭形象並非普通凡人的自然狀態。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "作為克萊恩的信使，她與主角的合作涉及等價交換、契約以及彼此的利益邊界。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "她的高序列身份和真正經歷屬極高層情報，普通低序列玩家甚至難以意識到其存在。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "以秘密契約、信使儀式或節制派高階任務接觸，禁止作無條件隨從。",
      "verification": "needs_original_chapter"
    }
  ],
