      "part": 1,
      "title": "遠古太陽神的分身",
      "summary": "薩斯利爾承接遠古太陽神部分人格及權柄，並不是與祂毫不相關的普通天使。",
      "verification": "secondary_reference"
    },
    {
      "part": 2,
      "title": "暗天使",
      "summary": "作為八大天使之王的重要領導者，他與第一塊褻瀆石板和混沌海相關。",
      "verification": "secondary_reference"
    },
    {
      "part": 3,
      "title": "救贖薔薇",
      "summary": "他參與救贖薔薇的核心計畫，涉及遠古太陽神面對內部意志甦醒的困境。",
      "verification": "secondary_reference"
    },
    {
      "part": 4,
      "title": "第三紀結局",
      "summary": "遠古太陽神隕落後，他的意識與殘留執念出現不同的後續狀態，不能全部視為同一具身體的連續人生。",
      "verification": "secondary_reference"
    },
    {
      "part": 5,
      "title": "巨人王庭殘靈",
      "summary": "第五紀的白銀城探索觸及薩斯利爾殘留惡靈，這是探索與神棄之地劇情的重要節點。",
      "verification": "secondary_reference"
    }
  ],
