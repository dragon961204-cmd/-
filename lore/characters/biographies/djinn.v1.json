  "narrative_biography": {
    "schema_version": "1.0",
    "title": "燈神｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "被封在許願神燈",
        "prose": "燈神是被封入許願神燈的高位存在，自稱永恆。點燃燈芯便可能見到祂的淡金人影；許願者可以求祂實現願望，但實現方式及代價可能被扭曲。第五紀時，神燈由貝爾納黛掌握。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-c662948bd5a5.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "向克萊恩提出交易",
        "prose": "燈神透過嘉德麗雅一側接觸灰霧上的克萊恩，提出以願望換取解封、返回星空。克萊恩後來借助神燈，使烏托邦在靈界形成對應區域，從而完成詭秘侍者晉升儀式所需的效果。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-c662948bd5a5.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "承諾仍待兌現",
        "prose": "克萊恩爭奪愚者神位時，燈神又與特倫索斯特黃銅書制定規則的過程有關。祂仍要求克萊恩兌現承諾；到了《宿命之環》末期，祂依然封在由貝爾納黛掌握的神燈中。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-c662948bd5a5.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
