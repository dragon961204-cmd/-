  "narrative_biography": {
    "schema_version": "1.0",
    "title": "馬赫特議員｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "退伍軍官的社交網",
        "prose": "馬赫特在貝克蘭德擔任議員，和妻子莉亞娜、女兒海柔爾同住。他帶道恩·唐泰斯進入貴族與退伍軍官的社交圈，介紹霍爾伯爵和國防部的加爾文上校，讓道恩有機會洽談軍火買賣。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-4853c2f4fde7.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "從街頭襲擊到家中的異常",
        "prose": "一家人和道恩外出用餐後，他曾在街上遇襲，所幸襲擊者被制伏。海柔爾追隨老鼠半神所引來的危機則直接進入他家，阿蒙的寄生使馬赫特一家也成為事件中的受害者。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-4853c2f4fde7.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "戰時的安排",
        "prose": "戰爭迫近貝克蘭德時，馬赫特打算把妻女送去家中的麋鹿莊園避難。他也答應幫道恩採購莊園所需的武器與糧食，兩人的來往於是從投資和軍火延續到戰時物資。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-4853c2f4fde7.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
