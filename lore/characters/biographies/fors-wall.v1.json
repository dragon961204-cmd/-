  "historical_sections": [
    {
      "part": 1,
      "title": "人物起點",
      "summary": "佛爾思在貝克蘭德靠小說創作維生，重視安穩日常，與休建立相互支持的朋友關係。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "接觸學徒途徑及亞伯拉罕家族相關傳承後，她開始遭遇滿月時的異常呼喚與非凡危機。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "以魔術師加入塔羅會後可透過聚會獲取材料與知識，並逐步認識家族詛咒的歷史。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "她對遠行與冒險常抱保留態度，卻在重大責任前逐漸成長；後期身分與力量不可投射到1349年。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "玩家需先從出版、委託、休的人脈或學徒傳承相關線索建立聯繫。",
      "verification": "needs_original_chapter"
    }
  ],
