  "narrative_biography": {
    "schema_version": "1.0",
    "title": "莫蘭·阿維尼｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "以工業部長身分活動",
        "prose": "莫蘭是因蒂斯工業部長，在特里爾有官邸和官方護衛。盧米安和芙蘭卡循著鏡中人的線索追查他，昂古萊姆則利用淨化者的渠道提供官邸安保資料。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-b7228e462eb0.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "兩路行動逼近官邸",
        "prose": "K先生潛入官邸行刺時受到淨化者攻擊，藉傳送脫身。盧米安等人也循地圖深入官邸，莫蘭最後遁入鏡中，追查因而從部長的公開身分轉入鏡中世界。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-b7228e462eb0.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "被擒後供出名單",
        "prose": "莫蘭在鏡中遭到控制後，供出一批鏡中人的名字。他的落網使調查者得以從一位部長的異常，追到其他混入現實社會的鏡中人。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-b7228e462eb0.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
