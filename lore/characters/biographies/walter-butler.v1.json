  "narrative_biography": {
    "schema_version": "1.0",
    "title": "瓦爾特｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "受僱於道恩·唐泰斯",
        "prose": "克萊恩以道恩·唐泰斯的身分在貝克蘭德安家時，聘用瓦爾特管理家務。瓦爾特替他物色貼身男僕，最後選中自東拜朗來的理查德森，並安排其他僕人的日常工作。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-fbbb62939e8a.html",
          "https://lordofthemysteries.fandom.com/wiki/Walter"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "曾在康拉德子爵家任職",
        "prose": "瓦爾特曾在康拉德子爵家擔任土地管事與助理管家，也在那段日子認識並獲得埃德薩克王子的賞識。王子死後，他離開子爵府，後來接受克萊恩面試，轉到唐泰斯家任職。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-fbbb62939e8a.html",
          "https://lordofthemysteries.fandom.com/wiki/Walter"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "替埃德薩克追查死因",
        "prose": "管理唐泰斯家務期間，瓦爾特仍對已故王子忠心。他私下和特莉絲合作，利用管家的身分蒐集消息，調查王子自盡背後的真相。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-fbbb62939e8a.html",
          "https://lordofthemysteries.fandom.com/wiki/Walter"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
