  "narrative_biography": {
    "schema_version": "1.0",
    "title": "卡維圖瓦｜連貫生平敘事初稿",
    "status": "pending_user_review",
    "sections": [
      {
        "part": 1,
        "title": "被奉為海神的海蛇",
        "prose": "卡維圖瓦是羅思德群島土著奉為守護神的巨型海蛇。反抗軍也有大量信徒，向它祈求免於海嘯和地震；卡維圖瓦則藏身在現實與靈界交會的海底精靈遺跡。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-345b2c212bfd.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 2,
        "title": "失控與隕落",
        "prose": "拉蒂西亞在西彌姆島的行動令它走向崩潰。它瀕死時企圖掀起海嘯，風暴教會的海王亞恩·考特曼出手阻止。克萊恩循獻祭定位其藏身處，確認它已死亡。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-345b2c212bfd.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      },
      {
        "part": 3,
        "title": "尊名繼續得到回應",
        "prose": "卡維圖瓦的蛇牙和遺留特性凝成海神權杖，由克萊恩取得。反抗軍面對自行破碎的神像祈禱時，後來回應他們的是藉權杖承接海神身分的克萊恩。",
        "source_pages": [
          "https://lotmfanwiki.com/node/cn-p-345b2c212bfd.html"
        ],
        "status": "original_narrative_draft_pending_user_review"
      }
    ],
