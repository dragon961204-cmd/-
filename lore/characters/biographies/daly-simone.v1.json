  "historical_sections": [
    {
      "part": 1,
      "title": "人物起點",
      "summary": "戴莉曾在廷根工作，熟悉通靈與非凡調查；她的風格較開放，但仍遵守處理危險物品的教會紀律。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 2,
      "title": "進入非凡世界",
      "summary": "她與鄧恩之間的情感未能簡單化為公開伴侶關係，兩人不同職務安排和心理顧慮影響行動。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 3,
      "title": "命運轉折",
      "summary": "廷根危機後，她仍留在官方非凡世界，與倫納德的追查目標出現交集。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 4,
      "title": "長期衝突",
      "summary": "對因斯的復仇不僅是報案或打鬥，也是長期調查、教會情報與個人情感的交匯。",
      "verification": "needs_original_chapter"
    },
    {
      "part": 5,
      "title": "遊戲接觸限制",
      "summary": "適合在廷根調查及後續教會事件出場，不可使用角色尚未掌握的後期情報。",
      "verification": "needs_original_chapter"
    }
  ],
